# Copy to .env and fill in. Never commit .env.
# This file IS committed (root .gitignore has `!.env.example`) -- keep it free of
# real credentials.

# --- Fish Audio -------------------------------------------------------------
# https://fish.audio/app/api-keys
FISH_API_KEY=

# Optional. A VOICE id from your Fish account -- NOT an API key. Blank = the
# model's stock voice. GET /voices on the running server lists what you have.
FISH_REFERENCE_ID=

# The SDK type-hints only speech-1.5 | speech-1.6 | s1 | s2-pro, but that Literal
# is not enforced at runtime -- the value goes straight through as an HTTP header,
# so newer ids work too:
#   s2.1-pro-free  free tier, same quality, no latency guarantee
#   s2.1-pro       paid, best latency
#   s2-pro         previous generation, the SDK's own default
FISH_TTS_MODEL=s2.1-pro-free

# balanced = ~300ms time-to-first-audio | normal = ~500ms, higher quality
FISH_LATENCY=balanced

# PCM output rate. 44100 is Fish's native rate and always safe. Lowering this to
# 24000 halves the bytes on the wire if your account supports it.
FISH_SAMPLE_RATE=44100
FISH_SPEED=1.0

# --- Fish Audio speech-to-text (the "hold to talk" button) ------------------
# NOTE: ASR is billed separately from TTS. An account with TTS credit but no
# API credit answers HTTP 402 -- add credit at fish.audio/app/developers.
#
# 16 kHz mono is standard for recognition; higher rates are bytes the
# recogniser discards. The browser records at whatever is set here.
STT_SAMPLE_RATE=16000

# ISO-639-1, e.g. en or sv. Leave blank to let Fish detect it, which is what
# you want if callers switch between English and Swedish mid-order.
STT_LANGUAGE=

# Longest single press of the talk button, in seconds.
STT_MAX_SECONDS=60

# --- OpenAI -----------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBED_MODEL=text-embedding-3-small

# Sampling temperature. Leave blank to send no temperature at all, which is what
# the gpt-5 / reasoning families require (they reject anything but the default).
OPENAI_TEMPERATURE=

# --- Brain / RAG ------------------------------------------------------------
# Drop .md/.txt/.pdf into docs/ then run: python -m rag.ingest
RAG_ENABLED=true
RAG_TOP_K=4
# Chroma collection the knowledge base is stored under.
COLLECTION_NAME=voice_kb
CHUNK_SIZE=800
CHUNK_OVERLAP=100
MAX_HISTORY_TURNS=8

# Optional. Overrides the built-in voice-tuned persona in config.py.
SYSTEM_PROMPT=

# --- Ordering bot (/order.html) ---------------------------------------------
# Speaks with the Fish Audio settings above -- same voice as the assistant.
#
# Its brain is set separately, because gpt-4o-mini is not reliable enough to
# drive thirteen tools: it does arithmetic in its head instead of calling
# get_cart, and wanders off the ordering routine. gpt-4.1-mini also reaches
# first token faster, so this costs nothing.
ORDER_MODEL=gpt-4.1-mini

# Optional. Overrides the built-in order-taker persona in config.py.
ORDER_SYSTEM_PROMPT=

# --- Speedoy ordering API ---------------------------------------------------
# Endpoints and auth come from the Postman collection. The bot-facing endpoints
# authenticate with a bare `ApiKey` header, not the older per-user GUID tokens.
SPEEDOY_BASE_URL=https://speedoy-api-dev.azurewebsites.net
SPEEDOY_API_KEY=

# Optional, development only. getOrderdetail rejects the ApiKey above with a 403
# and wants a per-user GUID; the bot never needs it to take an order, but it is
# the only way to read a placed order back and check the totals the server kept.
SPEEDOY_USER_TOKEN=

# Rondellen Pizzeria (Test) and the guest customer used by the phone-bot sample.
SPEEDOY_RESTAURANT_ID=5f3e6876bd7f2e2d8492c887
SPEEDOY_CUSTOMER_ID=5efd82a774f06456cc896ebf

# Orders with a blank email are refused as "Profile not complete". Callers are
# not asked to spell one out loud, so this stands in when none is offered.
SPEEDOY_DEFAULT_EMAIL=orders@thebotss.com

# Seconds before the in-memory menu is re-fetched.
MENU_TTL_SECONDS=900
SPEEDOY_TIMEOUT=30

# Used when geocoding the caller's spoken address fails. The order payload
# requires a lat/long and there is no sensible null.
SPEEDOY_DEFAULT_LAT=59.32986991484339
SPEEDOY_DEFAULT_LON=18.078129776774492

# Nominatim: free, no key, but it requires an identifying User-Agent and rate
# limits to one request per second. Set false to always use the defaults above.
GEOCODER_ENABLED=true
GEOCODER_USER_AGENT=speedoy-voice-bot/1.0
GEOCODER_COUNTRY_CODES=se

# --- Server -----------------------------------------------------------------
HOST=0.0.0.0
PORT=8010
